{
  "manifest_version": 3,
  "name": "Codeforces Streak",
  "description": "Track your Codeforces daily solving streak in Firefox.",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://codeforces.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Codeforces Streak",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
