{
  "manifest_version": 3,
  "name": "CF Streak Tracker",
  "version": "1.0.0",
  "description": "Track Codeforces submission streaks directly from your browser",

  "action": {
    "default_popup": "popup.html",
    "default_title": "CF Streak"
  },

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://codeforces.com/*"
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "cf-streak@pranit.dev",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [],
        "optional": []
      }
    }
  }
}
